{
  "name": "trackr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "fixtures": "tsx scripts/gen-fixtures.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node --env-file=.env --import tsx scripts/check-tokens.ts"
  },
  "dependencies": {
    "mcp-use": "2.10.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "vitest": "4.1.12"
  }
}
